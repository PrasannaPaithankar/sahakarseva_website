<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Configure your SMTP settings here -->
    <add key="SmtpServer" value="smtp.zoho.in" />
    <add key="SmtpPort" value="587" />
    <add key="SmtpUser" value="contact@sahakarseva.com" />
    <add key="SmtpPass" value="5JU2qUe3CrMg" />
    <add key="SmtpEnableSsl" value="true" />
    
    <!-- Target email to receive the contact form submissions -->
    <add key="TargetEmail" value="contact@sahakarseva.com" />
  </appSettings>
  
  <system.web>
    <customErrors mode="Off" />
  </system.web>
  
  <system.webServer>
    <httpErrors errorMode="Detailed" />
  </system.webServer>
</configuration>
